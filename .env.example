QDRANT_URL=
QDRANT_PATH=./qdrant_storage
# CRAG verdict threshold (p09 --crag-threshold / p00 --crag-threshold)
RAG_CRAG_THRESHOLD=0.65
# Plugin defaults (p05 --dense-backend / --dense-model / --sparse-model); later phases read them from the P05 artifact
RAG_DENSE_BACKEND=sentence_transformers
RAG_DENSE_MODEL=jinaai/jina-embeddings-v3
RAG_SPARSE_MODEL=prithivida/Splade_PP_en_v1
# Texts per dense/sparse encode call in p05 (--embed-batch-size); lower it on small-RAM hosts
RAG_EMBED_BATCH_SIZE=16
# Reranker defaults (p08 --backend / --model)
RAG_RERANK_BACKEND=sentence_transformers
RAG_RERANK_MODEL=BAAI/bge-reranker-v2-m3
# Model cache: huggingface_hub itself reads HF_HOME / HF_HUB_CACHE; set them in your environment to relocate it.
